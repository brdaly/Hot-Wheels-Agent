OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_IMAGE_DETAIL=auto
OPENAI_MAX_OUTPUT_TOKENS=3200
# Emergency cost-control switch. Set false and redeploy to pause billable analysis.
HOTWHEELS_ANALYSIS_ENABLED=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Auth UUID for the single invited owner account.
HOTWHEELS_OWNER_USER_ID=
# Independent 32+ byte secrets; generate each separately.
HOTWHEELS_SAFETY_ID_SECRET=
HOTWHEELS_READINESS_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Only enable behind a proxy that overwrites, rather than appends, client IP headers.
HOTWHEELS_TRUST_PROXY_HEADERS=false
# Local-only development convenience. Never enable in a shared or production environment.
HOTWHEELS_DEV_AUTH_BYPASS=false
# Analysis is ephemeral by default. Opt in only after reviewing the retention policy.
PERSIST_ANALYSES=false
ANALYSIS_RETENTION_DAYS=30
# Cost and abuse ceilings per authenticated owner.
HOTWHEELS_HOURLY_ANALYSIS_LIMIT=20
HOTWHEELS_DAILY_ANALYSIS_LIMIT=100
HOTWHEELS_MAX_CONCURRENT_ANALYSES=2
